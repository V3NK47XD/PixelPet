<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/peach_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Handle & Title -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_card_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Developer &amp; Advanced Tools ⚙️"
                android:textColor="@color/peach_light"
                android:textSize="17sp"
                android:fontFamily="sans-serif-bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDev"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:backgroundTint="@color/peach_dark" />
        </LinearLayout>

        <!-- Dev Section 1: Touch Debug Mode -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/peach_surface_card"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/peach_surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTouchDebug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Touch Debug Mode (Outlines Hitbox &amp; Pass-Through)"
                    android:textColor="@color/peach_light"
                    android:textSize="12sp"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Renders: Cyan = 100% Pass-Through, Green = Window Bounds, Magenta = Pet Hitbox."
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dev Section 2: Behavior Toggles -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/peach_surface_card"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/peach_surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHideAndSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Camera Hide-and-Seek (Ducks &amp; Peeks)"
                    android:textColor="@color/peach_light"
                    android:textSize="12sp"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPhoneEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="Phone Event Reactions (Charging/Battery)"
                    android:textColor="@color/peach_light"
                    android:textSize="12sp"
                    app:thumbTint="@color/switch_thumb_selector"
                    app:trackTint="@color/switch_track_selector" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dev Section 3B: Punch Anger Tantrum Timer -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/peach_surface_card"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/peach_surface_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobTantrumDuration"
                    android:layout_width="72dp"
                    android:layout_height="72dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Punch Anger Timer"
                        android:textColor="@color/peach_light"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Seconds pet stays angry when punched before blushing and calming down."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- Dev Section 5: Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenActiveLog"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Active App Log 🐞"
                android:textColor="@color/background_dark"
                android:textSize="11sp"
                app:backgroundTint="@color/peach_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlockRestricted"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Fix Restricted 🔓"
                android:textColor="@color/peach_light"
                android:textSize="11sp"
                app:backgroundTint="@color/peach_surface_card"
                app:cornerRadius="8dp"
                app:strokeColor="@color/peach_surface_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
