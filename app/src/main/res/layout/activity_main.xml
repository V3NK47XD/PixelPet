<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/peach_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixel Pet 🐣"
                android:textColor="@color/peach_light"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera Companion • Zero-Scroll Controls"
                android:textColor="@color/peach_accent"
                android:textSize="10.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDevTools"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/peach_surface"
            android:text="⚙️"
            android:textSize="14sp"
            app:cornerRadius="19dp"
            app:strokeColor="@color/peach_surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPetMaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/peach_primary"
            app:trackTint="@color/peach_surface_card" />
    </LinearLayout>

    <!-- 2. Compact Status Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Overlay: 🟢"
            android:textColor="@color/peach_light"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvBatteryBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Battery: ⚡"
            android:textColor="@color/peach_light"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvUsageBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Usage: 🟢"
            android:textColor="@color/peach_light"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Compact Permission Action Banner (Visible only when permissions missing) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermissionAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#2A1B18"
        app:cardCornerRadius="10dp"
        app:strokeColor="#7F2315"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPermissionAlertText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ Permissions missing for floating pet."
                android:textColor="#FCA5A5"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickFixPermission"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Grant"
                android:textColor="@color/background_dark"
                android:textSize="10sp"
                app:backgroundTint="@color/smiley_yellow"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Live Interactive Pet Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1.1"
        app:cardBackgroundColor="@color/peach_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Tethered Stage Live Preview -->
            <com.dynamicisland.app.view.TetheredPetStageView
                android:id="@+id/previewTetherStage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewMoodDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😴 Idle • Floating near camera"
                    android:textColor="@color/peach_accent"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:id="@+id/btnTestDrift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Drift 🎲"
                    android:textColor="@color/peach_primary"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <!-- Compact Mood Selector Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMoods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodIdle"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="😴 Idle"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodHappy"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😄 Happy"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodSad"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥺 Sad"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodAngry"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😡 Angry"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodNerd"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤓 Nerd"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodTexting"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Chat"
                        android:textSize="10sp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Rotary Speaker Knobs Deck (Replaces Long Sliders -> Zero-Scroll Space Saver!) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/peach_surface_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROTARY CONTROL DECK • DIAL TO ADJUST"
                android:textColor="@color/peach_accent"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif-bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobCameraX"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobCameraY"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobPetSize"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobLeash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Quick Camera Presets & Leash Colors Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Camera Presets -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignLeft"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="◀ Left"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                app:backgroundTint="@color/peach_surface"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignCenter"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="⏺ Center"
                android:textColor="@color/background_dark"
                android:textSize="9.5sp"
                app:backgroundTint="@color/peach_primary"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignRight"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Right ▶"
                android:textColor="@color/text_primary"
                android:textSize="9.5sp"
                app:backgroundTint="@color/peach_surface"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Leash Colors -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashRed"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="🎀"
                android:textSize="12sp"
                app:backgroundTint="#F43F5E"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashGold"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="🎗️"
                android:textSize="12sp"
                app:backgroundTint="#F59E0B"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashSilver"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="🧵"
                android:textSize="12sp"
                app:backgroundTint="#E2E8F0"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashMint"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="🌿"
                android:textSize="12sp"
                app:backgroundTint="#34D399"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Essential Behavior Toggles Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/peach_surface_card"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchGyroPhysics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Fluid Keychain &amp; Tilt Physics 📱"
                android:textColor="@color/peach_light"
                android:textSize="11.5sp"
                app:thumbTint="@color/peach_primary"
                app:trackTint="@color/peach_dark" />

            <!-- Neutral Hold Calibration Row -->
            <LinearLayout
                android:id="@+id/layoutCalibrationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvCalibrationStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Neutral Hold: Default (45°)"
                    android:textColor="@color/peach_cream"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrateHold"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="10dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="0dp"
                    android:text="📐 Calibrate"
                    android:textColor="@color/peach_dark"
                    android:textSize="10.5sp"
                    app:backgroundTint="@color/peach_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSleepiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Late-Night Sleepiness (Lavender Zzz) 🌙"
                android:textColor="@color/peach_light"
                android:textSize="11.5sp"
                app:thumbTint="@color/peach_primary"
                app:trackTint="@color/peach_dark" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchTouchReactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Pet Touch Interactions (Drag &amp; Tap) 👆"
                android:textColor="@color/peach_light"
                android:textSize="11.5sp"
                app:thumbTint="@color/peach_primary"
                app:trackTint="@color/peach_dark" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
