<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/peach_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Top Header Bar: Pet Name, Settings & Master Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Kiddo"
                    android:textColor="@color/peach_light"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPetName"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:text="✎"
                    android:textColor="@color/peach_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/peach_surface" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPetTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera Cutout Companion"
                android:textColor="@color/peach_accent"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Centered & Crisp Settings Gear Icon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDevTools"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/peach_surface"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/peach_cream"
            app:strokeColor="@color/peach_surface_border"
            app:strokeWidth="1dp" />

        <!-- Clean Toggle Switch (Never fills with solid ugly block) -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPetMaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>

    <!-- 2. Clean Status Cards Row (No Emoji Clutter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Overlay Active"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvBatteryBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Battery Safe"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvUsageBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="App Detect"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Permission Banner (Visible only when permissions missing) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermissionAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#2A1B18"
        app:cardCornerRadius="12dp"
        app:strokeColor="#7F2315"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPermissionAlertText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Permissions needed for floating companion."
                android:textColor="#FCA5A5"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickFixPermission"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Grant"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="@color/peach_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Live Interactive Pet Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1.1"
        app:cardBackgroundColor="@color/peach_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Tethered Stage Live Preview -->
            <com.dynamicisland.app.view.TetheredPetStageView
                android:id="@+id/previewTetherStage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewMoodDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Kiddo • Floating near camera"
                    android:textColor="@color/peach_light"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnTestDrift"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_card_surface"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Drift"
                    android:textColor="@color/peach_primary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Mood Selector Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMoods"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodIdle"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Idle"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodHappy"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Happy"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodSad"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sad"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodAngry"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Angry"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodNerd"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nerd"
                        android:textSize="10sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMoodTexting"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat"
                        android:textSize="10sp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Rotary Control Deck -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/peach_surface_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="KEYCHAIN CONTROLS"
                android:textColor="@color/peach_accent"
                android:textSize="9.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobCameraX"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobCameraY"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobPetSize"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.dynamicisland.app.view.RotaryKnobView
                    android:id="@+id/knobLeash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Quick Camera Alignment & Leash Colors Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Camera Presets -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignLeft"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Left"
                android:textColor="@color/peach_light"
                android:textSize="10sp"
                app:backgroundTint="@color/peach_surface"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignCenter"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Center"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="@color/peach_primary"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignRight"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Right"
                android:textColor="@color/peach_light"
                android:textSize="10sp"
                app:backgroundTint="@color/peach_surface"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Leash Colors -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="0.9"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashRed"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Red"
                android:textColor="@color/duo_text_white"
                android:textSize="10sp"
                app:backgroundTint="#F43F5E"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashGold"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Gold"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="#F59E0B"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashSilver"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Silver"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="#E2E8F0"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeashMint"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Mint"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="#34D399"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Essential Behavior Toggles Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/peach_surface_card"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchGyroPhysics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Keychain Gravity Mode (OFF: Drift)"
                android:textColor="@color/peach_light"
                android:textSize="12sp"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />

            <!-- Neutral Hold Calibration Row -->
            <LinearLayout
                android:id="@+id/layoutCalibrationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvCalibrationStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Neutral Hold: Calibrated"
                    android:textColor="@color/peach_cream"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrateHold"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:text="Calibrate Angle"
                    android:textColor="@color/peach_dark"
                    android:textSize="11sp"
                    app:backgroundTint="@color/peach_primary"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSleepiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Night Sleepiness (10 PM – 7 AM)"
                android:textColor="@color/peach_light"
                android:textSize="12sp"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchTouchReactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Touch Interactions (Drag &amp; Tap)"
                android:textColor="@color/peach_light"
                android:textSize="12sp"
                app:thumbTint="@color/switch_thumb_selector"
                app:trackTint="@color/switch_track_selector" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
