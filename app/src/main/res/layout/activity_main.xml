<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/peach_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Top Header Bar: Pet Name, Rename & Master Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPetName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Kiddo"
                    android:textColor="@color/peach_light"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditPetName"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:text="✎"
                    android:textColor="@color/peach_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/peach_surface" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPetTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera Cutout Companion"
                android:textColor="@color/peach_accent"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Clean Master Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPetMaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />
    </LinearLayout>

    <!-- 2. Clean Status Cards Row (No Emoji Clutter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOverlayBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Overlay Active"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvBatteryBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Battery Safe"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvUsageBadge"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_surface"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="App Detect"
            android:textColor="@color/peach_cream"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Permission Banner (Visible only when permissions missing) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermissionAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#2A1B18"
        app:cardCornerRadius="12dp"
        app:strokeColor="#7F2315"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvPermissionAlertText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Permissions needed for floating companion."
                android:textColor="#FCA5A5"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickFixPermission"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Grant"
                android:textColor="@color/peach_dark"
                android:textSize="10sp"
                app:backgroundTint="@color/peach_primary"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Live Interactive Pet Preview Card (Hero Area) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/peach_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Tethered Stage Live Preview -->
            <com.dynamicisland.app.view.TetheredPetStageView
                android:id="@+id/previewTetherStage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPreviewMoodDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Kiddo • Floating near camera"
                    android:textColor="@color/peach_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnTestDrift"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_card_surface"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Drift"
                    android:textColor="@color/peach_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Five Modular Settings Menus Below Preview (Zero Clutter Dashboard) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/peach_surface_card"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/peach_surface_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="SETTINGS &amp; CONTROLS"
                android:textColor="@color/peach_accent"
                android:textSize="9.5sp" />

            <!-- Row 1: Position Config & Pet Config -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuPosition"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Position Config"
                    android:textColor="@color/peach_light"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/peach_surface"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuPet"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Pet Config"
                    android:textColor="@color/peach_light"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/peach_surface"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Row 2: Sound Config & App Reactions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuSound"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Sound Config"
                    android:textColor="@color/peach_light"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/peach_surface"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenuReactions"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="App Reactions"
                    android:textColor="@color/peach_light"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-bold"
                    app:backgroundTint="@color/peach_surface"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Row 3: Developer Tools -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuDevTools"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:padding="0dp"
                android:text="Developer Tools &amp; Debug"
                android:textColor="@color/peach_cream"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/peach_surface"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
